# Composer-managed dependencies and Drupal core/contrib.
/vendor/
/web/core/
/web/libraries/*
/web/modules/contrib/
/web/profiles/contrib/
/web/themes/contrib/
/drush/Commands/contrib/

# Local-only Composer override (path repo for registration_theme).
/composer.local.json

# Standalone contrib checkouts (own git history/remotes, not part of this repo).
/themes/*
/modules/*
/ansible/*

# Runtime/uploaded content.
/web/sites/*/files/

# Environment-specific settings (per-machine, dropped by Ansible or created locally).
/web/sites/*/settings.local.php

# Local key files.
*.key

# Local dev/IDE noise.
.ddev/.env*
# Use this to set a deterministic DB port for local dev
.ddev/config.db-port.yaml
# Used to for composer.local.json to map when using ddev
.ddev/docker-compose.mounts.yaml
*.log
/.editorconfig
# ddev-saml-idp-certs
.ddev/saml-idp/certs/
