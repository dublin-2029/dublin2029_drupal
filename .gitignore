# Composer-managed dependencies and Drupal core/contrib.
/vendor/
/web/core/
/web/libraries/*
/web/modules/contrib/
/web/profiles/contrib/
/web/themes/contrib/
/drush/Commands/contrib/

# Local-only Composer override (path repo for registration_theme).
/composer.local.json

# Standalone contrib checkouts (own git history/remotes, not part of this repo).
/themes/*
/modules/*
/ansible/*

# Runtime/uploaded content.
/web/sites/*/files/

# Environment-specific settings (per-machine, dropped by Ansible or created locally).
/web/sites/*/settings.local.php

# Local secret files (Stripe/MailerLite API keys, consumed by the Drupal
# `key` module's file provider). Named .txt rather than .key so they don't
# read as real encryption key material.
/stripe-secret.txt
/stripe-public.txt
/mailerlite.txt

# Local dev/IDE noise.
.ddev/.env*
# Use this to set a deterministic DB port for local dev
.ddev/config.db-port.yaml
# Used to for composer.local.json to map when using ddev
.ddev/docker-compose.mounts.yaml
*.log
/.editorconfig
# ddev-saml-idp-certs
.ddev/saml-idp/certs/

# Files to ignore for SimpleSAML
simplesaml/dev/certs/*
simplesaml/dev/cache/admin/*
simplesaml/dev/cache/core/*
simplesaml/dev/log/*
simplesaml/dev/tmp/*
simplesaml/dev/data/*
# 
simplesaml/prod/certs/*
simplesaml/prod/cache/admin/*
simplesaml/prod/cache/core/*
simplesaml/prod/log/*
simplesaml/prod/tmp/*
simplesaml/prod/data/*
